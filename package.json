{
  "name": "academicos",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "AcademicOS — From Assignment to Evidence",
  "overrides": {"uuid":"^11.1.1"},
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "bootstrap:root": "node scripts/bootstrap-root.mjs",
    "emulators": "firebase emulators:start --project academicos-local",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "emulators:auth:test": "firebase emulators:exec --only auth --project academicos-local 'FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=academicos-local node scripts/test-auth-emulator.mjs'",
    "emulators:workflow:test": "firebase emulators:exec --only auth,firestore --project academicos-local 'FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=academicos-local node scripts/test-production-workflows.mjs'",
    "test:scale": "node scripts/scale-benchmark.mjs --records=1000000",
    "test:security": "tsx --test tests/security-regressions.test.ts",
    "test": "npm run typecheck && npm run test:core && npm run test:intelligence && npm run test:experience && npm run test:frontier && npm run test:roleplay && npm run test:tutor && npm run test:solver && npm run test:learncache && npm run test:security && npm run test:scale",
    "test:core": "tsx --test tests/core.test.ts",
    "test:intelligence": "tsx --test tests/intelligence.test.ts",
    "test:experience": "tsx --test tests/experience.test.ts",
    "test:frontier": "tsx --test tests/frontier.test.ts",
    "test:roleplay": "tsx --test tests/roleplay.test.ts",
    "test:tutor": "tsx --test tests/tutor.test.ts",
    "test:solver": "tsx --test tests/solver.test.ts",
    "test:learncache": "tsx --test tests/learn-cache.test.ts",
    "deploy:cloudrun": "bash scripts/deploy-cloud-run.sh"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "firebase-tools": "^15.28.1"
  }
}
