# ---- Runtime ----
NODE_ENV="development"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"
PORT="3000"
MAX_ASSIGNMENT_FILE_BYTES="20971520"
MAX_ASSIGNMENT_TOTAL_BYTES="62914560"
MAX_ASSIGNMENT_FILES="10"

# ---- AI Gateway ----
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
# Model alias/config belongs in environment/admin config, not business logic.
# Example current model may be supplied by your Google AI environment.
GEMINI_MODEL=""
GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
# Optional cost configuration used for internal cost attribution; users never see tokens.
AI_INPUT_COST_PER_MILLION_USD="0"
AI_OUTPUT_COST_PER_MILLION_USD="0"

# ---- Firebase Client (public web config) ----
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ---- Firebase Admin (server-side secret) ----
# On Google Cloud prefer Application Default Credentials and leave this blank.
# Outside Google Cloud, provide the service-account JSON as one environment value.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_STORAGE_BUCKET=""

# ---- Initial Root Owner bootstrap ----
# Used only by: npm run bootstrap:root
ROOT_OWNER_EMAIL=""
ROOT_OWNER_TENANT_ID="platform"

# ---- Billing abstraction ----
# Set to: disabled | stripe | tap | myfatoorah | lemonsqueezy
BILLING_PROVIDER="disabled"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stable per-student/project writing variation. Use a long random production secret.
PROJECT_VARIATION_SECRET=""

# ---- Platform controls ----
MAINTENANCE_MODE="false"
INCIDENT_BANNER=""
DATA_REGION="global"

# ---- Abuse / rate controls ----
# Per server instance. Put Cloud Armor / API Gateway / distributed limiting in front at global scale.
API_RATE_LIMIT_PER_MINUTE="180"
API_WRITE_RATE_LIMIT_PER_MINUTE="60"

# Optional external connector configuration (server-side only)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=
MOODLE_BASE_URL=
MOODLE_TOKEN=
BLACKBOARD_BASE_URL=
BLACKBOARD_CLIENT_ID=
BLACKBOARD_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# ---- AI routing / fallback / normalized provider gateways ----
# Comma-separated fallback IDs: gemini,openai,anthropic,local,institution
AI_PROVIDER_FALLBACKS=""
AI_REQUEST_TIMEOUT_MS="60000"
OPENAI_GATEWAY_URL=""
OPENAI_GATEWAY_TOKEN=""
OPENAI_MODEL=""
OPENAI_INPUT_COST_PER_MILLION_USD="0"
OPENAI_OUTPUT_COST_PER_MILLION_USD="0"
ANTHROPIC_GATEWAY_URL=""
ANTHROPIC_GATEWAY_TOKEN=""
ANTHROPIC_MODEL=""
ANTHROPIC_INPUT_COST_PER_MILLION_USD="0"
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD="0"
LOCAL_AI_GATEWAY_URL=""
LOCAL_AI_GATEWAY_TOKEN=""
LOCAL_AI_MODEL=""
LOCAL_AI_INPUT_COST_PER_MILLION_USD="0"
LOCAL_AI_OUTPUT_COST_PER_MILLION_USD="0"
INSTITUTION_AI_GATEWAY_URL=""
INSTITUTION_AI_GATEWAY_TOKEN=""
INSTITUTION_AI_MODEL=""
INSTITUTION_AI_INPUT_COST_PER_MILLION_USD="0"
INSTITUTION_AI_OUTPUT_COST_PER_MILLION_USD="0"

# ---- Operational isolated workers ----
PDF_RENDER_SERVICE_URL=""
PDF_RENDER_SERVICE_TOKEN=""
BACKUP_WORKER_URL=""
BACKUP_WORKER_TOKEN=""
CODE_SANDBOX_URL=""
CODE_SANDBOX_TOKEN=""
SEMANTIC_INDEX_URL=""
SEMANTIC_INDEX_TOKEN=""
TRANSLATION_SERVICE_URL=""
TRANSLATION_SERVICE_TOKEN=""
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_TOKEN=""

# ---- Notifications / communications ----
EMAIL_DELIVERY_ENDPOINT=""
PUSH_PROVIDER=""
PUSH_API_KEY=""
SMS_PROVIDER=""
SMS_API_KEY=""

# ---- Additional institutional connectors ----
BRIGHTSPACE_BASE_URL=""
BRIGHTSPACE_CLIENT_ID=""
BRIGHTSPACE_CLIENT_SECRET=""

# ---- Lifecycle / privileged support ----
ACCOUNT_DELETION_GRACE_DAYS="7"
# Impersonation requires BOTH this flag and tenant systemConfig.impersonationAllowed=true.
IMPERSONATION_ENABLED="false"

# AI Cost/Quality Router aliases. Low-risk/low-complexity tasks can use FAST; high-risk/high-complexity tasks can use STRONG.
AI_ECONOMY_PROVIDER=gemini
AI_BALANCED_PROVIDER=gemini
AI_HIGH_RISK_PROVIDER=gemini
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=
OPENAI_MODEL_FAST=
OPENAI_MODEL_STRONG=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_STRONG=
LOCAL_AI_MODEL_FAST=
LOCAL_AI_MODEL_STRONG=
INSTITUTION_AI_MODEL_FAST=
INSTITUTION_AI_MODEL_STRONG=
SECURITY_CONTACT_EMAIL=
RESPONSIBLE_DISCLOSURE_URL=

# Firebase App Check / privileged-session security
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_AUTH_EMULATOR_URL=
REQUIRE_APP_CHECK=false
REQUIRE_ADMIN_MFA=false
PRIVILEGED_REAUTH_MAX_AGE_SECONDS=600

# Isolated malware scanning for uploaded academic files
VIRUS_SCAN_URL=
VIRUS_SCAN_TOKEN=
REQUIRE_VIRUS_SCAN=false

# Arabic/English document OCR. A second provider enables disagreement detection.
OCR_PRIMARY_URL=
OCR_PRIMARY_TOKEN=
OCR_PRIMARY_NAME=
OCR_SECONDARY_URL=
OCR_SECONDARY_TOKEN=
OCR_SECONDARY_NAME=
OCR_ALLOWED_HOSTS=
OCR_MIN_CONFIDENCE=0.84
OCR_TIMEOUT_MS=60000
REQUIRE_OCR=false

# ---- Kuwait identity readiness (activation requires PACI/Kuwait Mobile ID onboarding) ----
PACI_IDENTITY_BASE_URL=
PACI_CLIENT_ID=
PACI_CLIENT_SECRET=
PACI_CALLBACK_SECRET=

# ---- Kuwait-ready hosted one-time project payments ----
# Prices are server-controlled in src/server/billing.ts. Choose: disabled, stripe, tap, myfatoorah.
BILLING_REQUEST_TIMEOUT_MS=15000
TAP_SECRET_KEY=
TAP_MERCHANT_ID=
TAP_SOURCE_ID=src_kw.knet
MYFATOORAH_API_TOKEN=
MYFATOORAH_PAYMENT_METHOD_ID=
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_API_BASE_URL=https://api.myfatoorah.com
# ---- Lemon Squeezy (Merchant of Record — global customers) ----
# API key: Settings > API. Store ID: Settings > Stores. Variant ID: the product variant you sell.
# Webhook secret: Settings > Webhooks (point it at /api/billing/webhook/lemonsqueezy, event: order_created).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# KWD plan prices are converted to USD at this rate for the checkout (adjust as needed).
LEMONSQUEEZY_KWD_USD_RATE=3.26

# Authenticated rate limits (shared-campus-network safe)
API_USER_RATE_LIMIT_PER_MINUTE=240
API_TENANT_RATE_LIMIT_PER_MINUTE=5000

# Evidence Capsule authenticity signing (optional). Base64-encode an Ed25519 PRIVATE KEY PEM and store the real value in Secret Manager / deployment secrets. The public key is embedded in signed capsules for independent verification.
EVIDENCE_CAPSULE_ED25519_PRIVATE_KEY_B64=
# Comma-separated Base64URL SPKI public keys retained as trusted verifiers after signing-key rotation.
EVIDENCE_CAPSULE_TRUSTED_PUBLIC_KEYS=
