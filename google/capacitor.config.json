{
  "appId": "kw.edu.academicos.app",
  "appName": "AcademicOS",
  "webDir": "www",
  "server": {
    "url": "https://academicos-edu.web.app",
    "errorPath": "offline.html",
    "allowNavigation": [
      "academicos-edu.web.app",
      "*.firebaseapp.com",
      "*.googleapis.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#EDF0F6",
      "showSpinner": false
    }
  },
  "android": {
    "backgroundColor": "#EDF0F6",
    "allowMixedContent": false
  }
}
